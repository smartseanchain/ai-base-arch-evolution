# 全站 SPA 静态产物（与 spa/README、make spa-build 一致）。构建前须在仓库根执行：make spa-build
# 构建：docker build -f Dockerfile.spa -t ai-arch-evolution:spa .
# 若 spa/dist 不存在，构建将失败 — 请先 npm run build / make spa-build。
FROM busybox:1.36
WORKDIR /www
COPY spa/dist/ /www/
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
CMD ["httpd", "-f", "-p", "80", "-h", "/www"]
