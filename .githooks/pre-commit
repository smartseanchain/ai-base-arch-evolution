#!/usr/bin/env sh
# 提交前校验 evolution JSON（可选启用：bash scripts/install-git-hooks.sh）
# 与 make validate / CI validate job 一致；参与贡献与 CI 双轨见根目录 CONTRIBUTING.md
set -e
ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
if ! command -v python3 >/dev/null 2>&1; then
  echo "pre-commit: 跳过（未找到 python3）"
  exit 0
fi
bash scripts/run_validate.sh
