{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/spa-nav-config.schema.json",
  "title": "spa/nav.config.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page", "label"],
        "properties": {
          "page": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.html$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1,
            "description": "可选；连续相同 group 的条目在顶栏合成一组下拉；缺省则单独成链"
          }
        }
      }
    }
  }
}
