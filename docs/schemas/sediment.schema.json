{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/sediment.schema.json",
  "title": "data/sediment.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "schema_version": { "type": "integer" },
    "notes": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "manifest_n", "candidate_n", "top_factors", "top_pages"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "manifest_n": { "type": "integer", "minimum": 0 },
          "candidate_n": { "type": "integer", "minimum": 0 },
          "top_factors": {
            "type": "array",
            "items": { "type": "string" }
          },
          "top_pages": {
            "type": "array",
            "items": { "type": "string" }
          },
          "hint_closure_gaps_n": { "type": "integer", "minimum": 0 },
          "hint_decisions_total": { "type": "integer", "minimum": 0 },
          "run_id": { "type": "string" },
          "repo_revision": { "type": "string" }
        }
      }
    }
  }
}
